{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "noPropertyAccessFromIndexSignature": false,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  },
  "include": [
    "wireview/static/wireview/*.js",
    "wireview/static/wireview/*.d.ts"
  ],
  "exclude": ["node_modules", "wireview/static/wireview/*.min.js"]
}
