# Copy to demo/ddns.env for direct mode's DDNS updater (compose.direct.yaml, `--profile ddns`,
# README "동적 IP"). Only the ddns service reads it: the token never reaches the app or the janitor.

# The zone's ID (itda.work's overview page, on the right)
CLOUDFLARE_ZONE_ID=
# A token with Zone -> DNS -> Edit on that zone and nothing else
CLOUDFLARE_DNS_TOKEN=
