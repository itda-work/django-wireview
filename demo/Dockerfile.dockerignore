# The build context is the repository root; send only what the images use.
*
!package.json
!package-lock.json
!esbuild.conf.js
!pyproject.toml
!uv.lock
!wireview
!examples
!demo
**/__pycache__
**/*.pyc
**/*.min.js
**/*.map
**/*.pyi
# The examples' screenshots go in as webp; the png copies are for the READMEs
examples/*/media/*.png
demo/.env
demo/.demo-data
