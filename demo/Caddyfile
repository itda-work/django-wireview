# The demo's front: /static/ from the files copied into this image, the rest to uvicorn.
# Plain HTTP (Caddy runs as an unprivileged user, demo/Dockerfile), on a port for each front door:
#
#   :8080  cloudflared, inside the compose network (TLS ends at Cloudflare). Also what the local
#          checks and compose's healthcheck use
#   :8081  direct mode: the host's own Caddy (demo/Caddyfile.direct) through the host's loopback
#          (compose.direct.yaml publishes it)
#
# Both reach it from private addresses (the compose network; colima's port forward). From them
# Caddy keeps X-Forwarded-Proto as sent -- "https" -- and reads the visitor's address from the
# header the one in front writes. Each port trusts its own front's header and no other: a
# visitor's X-Real-IP through Cloudflare, or CF-Connecting-IP to the host's Caddy, names no one.
# Both ports work at once, so a move from the tunnel to direct mode loses no visitor.
{
	admin off
	servers :8080 {
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP
	}
	servers :8081 {
		trusted_proxies static private_ranges
		client_ip_headers X-Real-IP
	}
}

(front) {
	log {
		output stdout
		format console
	}

	# No example takes uploads, so nothing a visitor sends needs more than a form's worth
	request_body {
		max_size 1MB
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}

	handle_path /static/* {
		root * /srv/static
		# What {% static %} names carries its content's hash (ManifestStaticFilesStorage,
		# demo/settings.py): kept a year, at Cloudflare's edge too. A new deploy names new files
		@hashed path_regexp \.[0-9a-f]{12}\.[A-Za-z0-9]+$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# The unhashed originals and the manifest: nothing names them, revalidated if asked for
		@unhashed not path_regexp \.[0-9a-f]{12}\.[A-Za-z0-9]+$
		header @unhashed Cache-Control "public, no-cache"
		file_server
	}

	handle {
		# Pages carry the visitor's session and CSRF token: no shared cache keeps them, even
		# if a Cloudflare rule ever said "cache everything". Django's own header wins
		header ?Cache-Control "private, no-cache"
		# WebSocket upgrades pass through on their own
		reverse_proxy app:8000 {
			# The visitor, for the demo's rate limits (demo/limits.py)
			header_up X-Real-IP {client_ip}
		}
	}
}

:8080 {
	import front
}

:8081 {
	import front
}
