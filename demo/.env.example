# Copy to demo/.env and fill in. docker compose reads it for the app and the janitor.

# Required. python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=

# The public name. ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS follow it unless set below.
DEMO_HOST=wireview-demo.itda.work
# DJANGO_ALLOWED_HOSTS=wireview-demo.itda.work,localhost,127.0.0.1,app,web
# DJANGO_CSRF_TRUSTED_ORIGINS=https://wireview-demo.itda.work
# Trying the stack locally with demo/smoke.py (README "로컬에서 확인"): add the local origin
# DJANGO_CSRF_TRUSTED_ORIGINS=https://wireview-demo.itda.work,http://127.0.0.1:8080

# 1 in production: Cloudflare says the visitor came over HTTPS. 0 only to try the stack over
# plain http://localhost without sending X-Forwarded-Proto: https.
DJANGO_SECURE_SSL_REDIRECT=1

# uvicorn workers
WEB_CONCURRENCY=2

# Daily reset (HH:MM in DEMO_TIME_ZONE) and how long a guest account lives
DEMO_RESET_AT=04:00
DEMO_TIME_ZONE=Asia/Seoul
DEMO_GUEST_MAX_AGE_HOURS=12

# Limits (demo/limits.py, demo/sessions.py). The defaults, and what each one counts, are
# DEMO_LIMITS in demo/settings.py; README "공개 데모의 안전장치" has them in a table.
# DEMO_TEXT_MAX=500
# DEMO_FRAME_MAX=65536
# DEMO_FRAME_BURST=120
# DEMO_FRAMES_PER_SECOND=20
# DEMO_JUNK_BURST=5
# DEMO_JUNK_PER_SECOND=0.2
# DEMO_EVENT_BURST=30
# DEMO_EVENTS_PER_SECOND=5
# DEMO_JOIN_BURST=60
# DEMO_JOINS_PER_SECOND=5
# DEMO_RENDER_BURST=20
# DEMO_RENDERS_PER_SECOND=2
# DEMO_VISITOR_WINDOW=10
# DEMO_VISITOR_FRAMES=600
# DEMO_VISITOR_EVENTS=100
# DEMO_VISITOR_RENDERS=300
# DEMO_SOCKETS_PER_MINUTE=300
# DEMO_OPEN_SOCKETS_PER_VISITOR=40
# DEMO_OPEN_SOCKETS_TOTAL=2000
# DEMO_REQUESTS_PER_MINUTE=300
# DEMO_POSTS_PER_MINUTE=60
# DEMO_SESSIONS_PER_HOUR=60
# DEMO_SESSIONS_MAX=20000
# DEMO_GUESTS_PER_HOUR=60
# DEMO_GUESTS_MAX=5000

# What the demo keeps of what visitors write (demo/retention.py): a chat room's newest messages,
# and the rows each of those tables may hold (a new row past it is refused)
# DEMO_KEEP_PER_ROOM=200
# DEMO_ROWS_MAX=20000

# The disk's last guard: the database file past this many MB, the janitor resets the demo early
# DEMO_DB_MAX_MB=1024

# HSTS in seconds (30 days); 0 turns it off
# DJANGO_HSTS_SECONDS=2592000

# Host port Caddy listens on (127.0.0.1 only)
DEMO_PORT=8080

# Only for `docker compose --profile tunnel up`: the token of the Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=
