# Channels has no default layer: without one every WebSocket is refused (wireview.W012).
# In-memory is right for one process. Several processes need channels-nats or
# channels_redis, or a broadcast reaches only its own process (wireview.W006).
CHANNEL_LAYERS = {
    "default": {"BACKEND": "channels.layers.InMemoryChannelLayer"},
}

