{
  "autoescape": "autoescape ${1|off,on|}",
  "block": "block ${1:name}",
  "blocktranslate": "blocktranslate",
  "cycle": "cycle ${1:'odd'} ${2:'even'}",
  "extends": "extends \"$1\"",
  "filter": "filter ${1:lower}",
  "firstof": "firstof ${1:a} ${2:b}",
  "for": "for ${1:item} in ${2:items}",
  "if": "if ${1:condition}",
  "ifchanged": "ifchanged",
  "include": "include \"$1\"",
  "language": "language \"${1:en}\"",
  "load": "load ${1:wireview}",
  "now": "now \"${1:Y-m-d}\"",
  "regroup": "regroup ${1:items} by ${2:attribute} as ${3:groups}",
  "static": "static \"$1\"",
  "templatetag": "templatetag ${1|openblock,closeblock,openvariable,closevariable,openbrace,closebrace,opencomment,closecomment|}",
  "translate": "translate \"$1\"",
  "url": "url \"$1\"",
  "widthratio": "widthratio ${1:value} ${2:max} ${3:100}",
  "with": "with ${1:name}=${2:value}",

  "class": "class {'${1:name}': ${2:condition}}",
  "component": "component \"$1\"",
  "component_block": "component_block \"$1\"",
  "cond": "cond {'${1:text}': ${2:condition}}",
  "fill": "fill ${1:slot}",
  "func": "func \"$1\"",
  "func_block": "func_block \"$1\"",
  "live_component": "live_component \"$1\" id=\"$2\"",
  "live_component_block": "live_component_block \"$1\" id=\"$2\"",
  "live_tag_header": "live_tag_header",
  "on": "on \"${1:click}\" \"$2\"",
  "render_slot": "render_slot \"$1\"",
  "tag_header": "tag_header",
  "upload_button": "upload_button \"${1:name}\"",
  "upload_drop_zone": "upload_drop_zone \"${1:name}\"",
  "upload_input": "upload_input \"${1:name}\"",
  "upload_preview": "upload_preview ${1:entry}",
  "wireview_header": "wireview_header",
  "wireview_toasts": "wireview_toasts"
}
