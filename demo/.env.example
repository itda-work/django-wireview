# Copy to demo/.env and fill in. docker compose reads it for the app and the janitor.

# Required. python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=

# The public name. ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS follow it unless set below.
DEMO_HOST=wireview-demo.itda.work
# DJANGO_ALLOWED_HOSTS=wireview-demo.itda.work,localhost,127.0.0.1,app,web
# DJANGO_CSRF_TRUSTED_ORIGINS=https://wireview-demo.itda.work
# Trying the stack locally with demo/smoke.py (README "로컬에서 확인"): add the local origin
# DJANGO_CSRF_TRUSTED_ORIGINS=https://wireview-demo.itda.work,http://127.0.0.1:8080

# 1 in production: Cloudflare says the visitor came over HTTPS. 0 only to try the stack over
# plain http://localhost without sending X-Forwarded-Proto: https.
DJANGO_SECURE_SSL_REDIRECT=1

# uvicorn workers
WEB_CONCURRENCY=2

# Daily reset (HH:MM in DEMO_TIME_ZONE) and how long a guest account lives
DEMO_RESET_AT=04:00
DEMO_TIME_ZONE=Asia/Seoul
DEMO_GUEST_MAX_AGE_HOURS=12

# Limits (demo/limits.py). The defaults are in demo/settings.py.
# DEMO_TEXT_MAX=500
# DEMO_EVENT_BURST=30
# DEMO_EVENTS_PER_SECOND=5
# DEMO_POSTS_PER_MINUTE=60
# DEMO_SOCKETS_PER_MINUTE=300
# DEMO_GUESTS_PER_HOUR=60

# Host port Caddy listens on (127.0.0.1 only)
DEMO_PORT=8080

# Only for `docker compose --profile tunnel up`: the token of the Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=
