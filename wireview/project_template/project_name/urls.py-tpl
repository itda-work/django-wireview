"""URL configuration for {{ project_name }}."""

from django.contrib import admin
from django.urls import include, path
from django.views.generic import TemplateView

urlpatterns = [
    path("admin/", admin.site.urls),
    # The chunked upload endpoint. At the root: without it only uploads fail, with a 404.
    path("", include("wireview.urls")),
    path("", TemplateView.as_view(template_name="hello/index.html"), name="index"),
]
